# Copy to secrets.env (gitignored). Every line is optional.

# Network to join when the device has no working stored credentials.
# Without it, a fresh device opens the "SmallTV-Setup" hotspot instead.
#WIFI_SSID=MyNetwork
#WIFI_PASS=MyPassword

# Protect /update with HTTP auth (user "admin"). Export OTA_PASS in your shell
# too so `pio run -t upload` can authenticate.
#OTA_PASS=change-me

# POSIX TZ string. Default is UK time.
#CLOCK_TZ=GMT0BST,M3.5.0/1,M10.5.0
